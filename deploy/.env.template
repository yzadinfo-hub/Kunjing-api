# ============================================================
# Zumeng API 环境变量模板
# 用法：cp .env.template .env && 编辑全部必填项
# ============================================================

# ---------- 必填：安全密钥（缺失则服务拒绝启动） ----------
# 会话签名密钥，多节点部署必须全节点一致。生成：openssl rand -base64 48
SESSION_SECRET=
# 缓存加密密钥，多节点共用 Redis 时必须全节点一致。生成：openssl rand -base64 48
CRYPTO_SECRET=

# ---------- 必填：数据库 ----------
POSTGRES_USER=zumeng
POSTGRES_PASSWORD=
POSTGRES_DB=zumeng

# ---------- 必填：Redis ----------
REDIS_PASSWORD=

# ---------- 必填：对外访问（SESSION_COOKIE_SECURE=true 时） ----------
# 精确的 HTTPS Origin，不含路径、不支持通配符，多个用英文逗号分隔
SESSION_COOKIE_TRUSTED_URL=https://api.example.com
# Docker 网段（反代所在网段），none 表示不信任任何代理
TRUSTED_PROXIES=172.20.0.0/16

# ---------- 镜像与端口 ----------
ZUMENG_IMAGE=ghcr.io/your-org/zumeng-api:latest
ZUMENG_PORT=3000

# ---------- 运行参数（可选） ----------
TZ=Asia/Shanghai
DEFAULT_LANGUAGE=zh-CN
NODE_NAME=zumeng-api-node-1
SYNC_FREQUENCY=60
STREAMING_TIMEOUT=600
SESSION_COOKIE_SECURE=true

# ---------- 可选：独立前端域名（多节点时） ----------
# FRONTEND_BASE_URL=https://console.example.com

# ---------- 可选：通知与校验 ----------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=notify@example.com
# SMTP_PASSWORD=
# SMTP_FROM=notify@example.com
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------- 可选：站点品牌（也可在系统设置里改，这里作初始值） ----------
# 站点名称会作为新实例的默认 SystemName，之后以数据库 Option 为准
# ZUMENG_SITE_NAME=Zumeng API
